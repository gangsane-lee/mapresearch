# ── 서버 ──────────────────────────────────────────────
# 127.0.0.1 외 값이면 API_TOKEN 필수 (미설정 시 기동 거부)
HOST=127.0.0.1
PORT=5180
API_TOKEN=

# ── DB (SQL Server 2025 Express .\SQLEXPRESS, 127.0.0.1:1433) ─
# localhost는 ::1로 먼저 해석될 수 있어 127.0.0.1 명시
DB_SERVER=127.0.0.1
DB_PORT=1433
# RealtyLog_DEV | RealtyLog_PROD
DB_NAME=RealtyLog_DEV
# 앱 런타임 로그인 (snapshot UPDATE/DELETE 거부 권한) — aptlog_dev_app | aptlog_prod_app
DB_USER=aptlog_dev_app
DB_PASSWORD=
# 마이그레이션 전용 로그인 (db_owner) — aptlog_dev_mig | aptlog_prod_mig
MIGRATE_USER=aptlog_dev_mig
MIGRATE_PASSWORD=
# 가계 시스템 DB (HH_DEV | HH_PROD) — 마이그레이션 변수 $(HH_DB)
HH_DB=HH_DEV

# ── 파일 ──────────────────────────────────────────────
MEDIA_ROOT=C:\AptLogData\media
# 당분간 같은 디스크 별도 폴더 (계획서 §8)
BACKUP_ROOT=C:\AptLogBackup

# ── 외부 API (프론트로는 NCP_KEY_ID만 노출) ──────────────
DATA_GO_KR_KEY=
NCP_KEY_ID=
NCP_CLIENT_SECRET=
KAKAO_REST_KEY=
