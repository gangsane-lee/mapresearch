# 이 파일을 .env 로 복사해 값을 채운다 (.env 는 커밋하지 않음). 주석의 [맥]/[윈도우] 는 OS별 예시.

# ── 서버 ──────────────────────────────────────────────
# 127.0.0.1 외 값이면 API_TOKEN 필수 (미설정 시 기동 거부)
HOST=127.0.0.1
PORT=5180
API_TOKEN=

# ── DB (SQL Server 2025, 127.0.0.1:1433) ───────────────
# [맥] docker-compose.yml 의 컨테이너  [윈도우] .\SQLEXPRESS
# localhost는 ::1로 먼저 해석될 수 있어 127.0.0.1 명시
DB_SERVER=127.0.0.1
DB_PORT=1433
# RealtyLog_DEV | RealtyLog_PROD
DB_NAME=RealtyLog_DEV
# 앱 런타임 로그인 (snapshot UPDATE/DELETE 거부 권한) — aptlog_dev_app | aptlog_prod_app
# 비밀번호: 12자 이상, ' " $ 사용 불가 (npm run db:setup 이 이 값으로 로그인을 만든다)
DB_USER=aptlog_dev_app
DB_PASSWORD=
# 마이그레이션·백업 전용 로그인 (db_owner) — aptlog_dev_mig | aptlog_prod_mig
MIGRATE_USER=aptlog_dev_mig
MIGRATE_PASSWORD=
# 가계 시스템 DB (HH_DEV | HH_PROD) — 마이그레이션 변수 $(HH_DB). 가계 DB가 없어도 마이그레이션은 된다
HH_DB=HH_DEV
# [맥] SQL Server 컨테이너 sa 비밀번호 (docker compose, npm run db:setup 에서만 사용)
#      8자 이상 + 대문자·소문자·숫자·특수문자 중 3종 (SQL Server 정책)
MSSQL_SA_PASSWORD=

# ── 파일 ──────────────────────────────────────────────
# [맥]    MEDIA_ROOT=/Users/<사용자>/AptLogData/media   BACKUP_ROOT=/Users/<사용자>/AptLogBackup
# [윈도우] MEDIA_ROOT=C:\AptLogData\media             BACKUP_ROOT=C:\AptLogBackup
MEDIA_ROOT=
# 당분간 같은 디스크 별도 폴더 (계획서 §8)
BACKUP_ROOT=
# SQL Server 가 보는 백업 폴더 경로. [맥] 컨테이너 안 경로 /var/opt/mssql/backup  [윈도우] 비워 둠(=BACKUP_ROOT\db)
BACKUP_SQL_DIR=

# ── 외부 API (프론트로는 NCP_KEY_ID만 노출) ──────────────
DATA_GO_KR_KEY=
NCP_KEY_ID=
NCP_CLIENT_SECRET=
KAKAO_REST_KEY=
